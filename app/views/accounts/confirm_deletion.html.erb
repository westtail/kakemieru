<h1>退会の確認</h1>

<%= render "shared/error_messages", record: Current.user %>

<p style="color:red">退会するとすべてのデータが削除されます。この操作は取り消せません。</p>

<%= form_with url: account_path, method: :delete do |form| %>
  <div>
    <%= form.label :current_password, "現在のパスワード" %><br>
    <%= form.password_field :current_password, required: true, autocomplete: "current-password" %>
  </div>
  <div>
    <%= form.label :confirmation, "確認のため「退会する」と入力してください" %><br>
    <%= form.text_field :confirmation, required: true %>
  </div>
  <%= form.submit "退会する" %>
<% end %>

<p><%= link_to "キャンセル", account_path %></p>
