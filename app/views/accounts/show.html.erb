<h1>アカウント設定</h1>

<%= render "shared/error_messages", record: Current.user %>

<section>
  <h2>メールアドレス変更</h2>
  <p>現在: <%= Current.user.email_address %></p>
  <%= form_with url: account_email_path, method: :patch do |form| %>
    <div>
      <%= form.label :email_address, "新しいメールアドレス" %><br>
      <%= form.email_field :email_address, required: true, autocomplete: "email" %>
    </div>
    <div>
      <%= form.label :current_password, "現在のパスワード" %><br>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password" %>
    </div>
    <%= form.submit "メールアドレスを変更" %>
  <% end %>
</section>

<section>
  <h2>パスワード変更</h2>
  <%= form_with url: account_password_path, method: :patch do |form| %>
    <div>
      <%= form.label :current_password, "現在のパスワード" %><br>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password" %>
    </div>
    <div>
      <%= form.label :password, "新しいパスワード" %><br>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div>
      <%= form.label :password_confirmation, "新しいパスワード（確認）" %><br>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit "パスワードを変更" %>
  <% end %>
</section>

<section>
  <h2>退会</h2>
  <p><%= link_to "退会手続きへ", confirm_account_deletion_path %></p>
</section>
