<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Kakemieru | 家計を見える化" %></title>
    <%= render "shared/head_tags" %>

    <%# デザインシステムのフォント（本文=Zen Kaku Gothic New / 数字=Roboto Mono）。
        公開 LP でのみ読み込む（認証後の家計データ画面から Google への IP/Referer 送出を避ける）。
        Referer 漏洩を抑えるため referrerpolicy=no-referrer を付与する。 %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" referrerpolicy="no-referrer"
          href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Roboto+Mono:wght@400;500;700&display=swap">
  </head>

  <body class="lp">
    <header class="lp-header">
      <%= link_to root_path, class: "lp-logo" do %>
        <svg class="lp-logomark" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="2"/>
          <line x1="15.4" y1="15.4" x2="21" y2="21" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
          <text x="10" y="13.7" text-anchor="middle" font-size="10" font-weight="800" fill="currentColor" font-family="'Roboto Mono', monospace">¥</text>
        </svg>Kakemieru
      <% end %>
      <nav class="lp-nav">
        <%= link_to "ログイン", new_session_path, class: "lp-btn lp-btn-ghost" %>
        <%= link_to "新規登録", new_registration_path, class: "lp-btn lp-btn-ink" %>
      </nav>
    </header>

    <%# フラッシュ（退会後リダイレクト等）は本文の外に置く %>
    <div class="lp-wrap lp-flash">
      <%= render "shared/flash" %>
    </div>

    <main>
      <%= yield %>
    </main>

    <footer class="lp-footer">
      &copy; <%= Date.current.year %> Kakemieru
    </footer>
  </body>
</html>
