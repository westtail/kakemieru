<%# アーカイブ済みの支払方法1行。append 先で識別できるよう dom_id を付与する（表示のみ）。 %>
<%# locals: payment_method %>
<li id="<%= dom_id(payment_method) %>" class="list-row list-row-mut">
  <span class="flex-1">
    <%= payment_method.name %>
    <span class="muted">（<%= PaymentMethodCatalog::LABELS[payment_method.payment_type] %>）</span>
  </span>
  <span class="badge badge-mut">アーカイブ済み</span>
</li>
