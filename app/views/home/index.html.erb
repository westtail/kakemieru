<div class="max-w-xl mx-auto"
     data-controller="dashboard"
     data-dashboard-summary-url-value="<%= summary_transactions_path %>"
     data-dashboard-transactions-url-value="<%= transactions_path %>"
     data-dashboard-month-value="<%= @month.strftime("%Y-%m") %>">

  <%# 月切り替え %>
  <div class="flex items-center justify-center gap-5">
    <button type="button" data-action="dashboard#prev" aria-label="前の月" class="iconbtn">←</button>
    <span data-dashboard-target="monthLabel" class="text-lg font-bold">
      <%= "#{@month.year}年#{@month.month}月" %>
    </span>
    <button type="button" data-action="dashboard#next" aria-label="次の月" class="iconbtn">→</button>
  </div>

  <%# 主カード: 支出合計・平均比・カテゴリ別ドーナツ・凡例・未分類 %>
  <div class="card mt-4">
    <div class="flex items-baseline justify-between gap-3 flex-wrap">
      <span class="muted">支出合計</span>
      <span data-dashboard-target="recentAverage" class="text-sm"></span>
    </div>
    <p data-dashboard-target="total" class="num text-3xl font-black mt-1">—</p>

    <p data-dashboard-target="error" class="hidden mt-2 text-sm" style="color:var(--alert)">
      データの取得に失敗しました。時間をおいて再度お試しください。
    </p>

    <div class="dash-row mt-4">
      <div class="dash-donut">
        <canvas data-dashboard-target="canvas" role="img" aria-label="カテゴリ別支出の円グラフ"></canvas>
      </div>
      <ul data-dashboard-target="legend" class="dash-legend"></ul>
    </div>

    <div class="divider"></div>
    <%# 未分類バッジ（件数・クリックで未分類フィルタの一覧へ） %>
    <div data-dashboard-target="uncategorized"></div>
  </div>

  <%# 月別推移・月平均の2カード %>
  <div class="grid gap-4 sm:grid-cols-2 mt-4">
    <div class="card">
      <p class="font-bold text-sm mb-2">月別の支出推移</p>
      <div class="dash-trend">
        <canvas data-dashboard-target="trendCanvas" role="img" aria-label="月別支出の棒グラフ"></canvas>
      </div>
    </div>
    <div id="monthly-average" class="card">
      <p class="font-bold text-sm mb-1">月平均支出（全体）</p>
      <p data-dashboard-target="monthlyAverageOverall" class="num text-2xl font-black">—</p>
      <ul data-dashboard-target="monthlyAverageCategories" class="dash-avg"></ul>
    </div>
  </div>

  <%# 取り込み導線 %>
  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <%= link_to "CSV取り込み", new_import_path(anchor: "csv-import"), class: "btn-outline" %>
    <%= link_to "手動入力", new_import_path(anchor: "manual-import"), class: "btn-outline" %>
  </div>
</div>
