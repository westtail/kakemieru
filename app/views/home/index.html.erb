<div class="max-w-xl"
     data-controller="dashboard"
     data-dashboard-summary-url-value="<%= summary_transactions_path %>"
     data-dashboard-transactions-url-value="<%= transactions_path %>"
     data-dashboard-month-value="<%= @month.strftime("%Y-%m") %>">

  <%# 月切り替え %>
  <div class="flex items-center justify-center gap-6">
    <button type="button" data-action="dashboard#prev" aria-label="前の月"
            class="text-blue-600 hover:underline">←</button>
    <span data-dashboard-target="monthLabel" class="text-lg font-bold">
      <%= "#{@month.year}年#{@month.month}月" %>
    </span>
    <button type="button" data-action="dashboard#next" aria-label="次の月"
            class="text-blue-600 hover:underline">→</button>
  </div>

  <%# 支出合計 %>
  <div class="mt-4 text-center">
    <p class="text-sm text-gray-600">支出合計</p>
    <p data-dashboard-target="total" class="text-3xl font-bold">—</p>
    <%# 直近3ヶ月平均との比較 %>
    <p data-dashboard-target="recentAverage" class="mt-1 text-sm"></p>
  </div>

  <%# 読み込みエラー %>
  <p data-dashboard-target="error" class="hidden mt-2 text-center text-red-600">
    データの取得に失敗しました。時間をおいて再度お試しください。
  </p>

  <%# カテゴリ別円グラフ %>
  <div class="mt-6">
    <canvas data-dashboard-target="canvas" role="img" aria-label="カテゴリ別支出の円グラフ"></canvas>
  </div>

  <%# 未分類バッジ（件数・クリックで未分類フィルタの一覧へ） %>
  <div data-dashboard-target="uncategorized" class="mt-4 text-center"></div>

  <%# 月別支出の推移（直近6ヶ月・棒グラフ） %>
  <div class="mt-8">
    <p class="mb-2 text-center text-sm text-gray-600">月別の支出推移</p>
    <canvas data-dashboard-target="trendCanvas" role="img" aria-label="月別支出の棒グラフ"></canvas>
  </div>

  <%# 月平均支出（実データのある月数で平均・全体＋カテゴリ別） %>
  <div id="monthly-average" class="mt-8">
    <p class="mb-1 text-center text-sm text-gray-600">月平均支出（全体）</p>
    <p data-dashboard-target="monthlyAverageOverall" class="text-center text-2xl font-bold">—</p>
    <ul data-dashboard-target="monthlyAverageCategories" class="mt-2"></ul>
  </div>

  <%# 取り込み導線 %>
  <div class="mt-6 flex flex-wrap justify-center gap-4">
    <%= link_to "CSV取り込み", new_import_path(anchor: "csv-import"),
          class: "inline-block px-4 py-2 border border-blue-600 rounded text-blue-600 no-underline hover:bg-blue-600 hover:text-white" %>
    <%= link_to "手動入力", new_import_path(anchor: "manual-import"),
          class: "inline-block px-4 py-2 border border-blue-600 rounded text-blue-600 no-underline hover:bg-blue-600 hover:text-white" %>
  </div>
</div>
