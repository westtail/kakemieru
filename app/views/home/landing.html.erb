<%# 未ログイン訪問者向けの公開ランディングページ（layouts/landing で全幅表示）。 %>

<%# ヒーロー %>
<section class="bg-gradient-to-b from-blue-50 to-white">
  <div class="max-w-3xl mx-auto px-4 py-16 text-center">
    <h1 class="text-3xl sm:text-4xl font-bold leading-tight">家計を、見える化。</h1>
    <p class="mt-4 text-base sm:text-lg text-gray-600">
      クレジットカードの明細CSVをアップロードするだけで、月別・カテゴリ別の収支を自動でグラフに。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <%= link_to "無料で始める", new_registration_path, class: "btn-primary" %>
      <%= link_to "ログイン", new_session_path, class: "btn-secondary" %>
    </div>
  </div>
</section>

<%# 主要機能 %>
<section class="max-w-3xl mx-auto px-4 py-12">
  <h2 class="text-center section-title mt-0">できること</h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded border border-gray-200 p-5">
      <h3 class="font-semibold">CSVで自動集計</h3>
      <p class="mt-2 muted">楽天カードのCSVをそのまま取り込み、手入力なしで明細化。金額のカンマや文字コードも自動処理。</p>
    </div>
    <div class="rounded border border-gray-200 p-5">
      <h3 class="font-semibold">カテゴリを自動分類</h3>
      <p class="mt-2 muted">店舗ルール・特別ルールを登録しておけば、次回以降の取り込みを自動でカテゴリ分け。</p>
    </div>
    <div class="rounded border border-gray-200 p-5">
      <h3 class="font-semibold">月次ダッシュボード</h3>
      <p class="mt-2 muted">カテゴリ別円グラフ・支出推移・月平均・直近3ヶ月比較で、使いすぎがひと目で分かる。</p>
    </div>
  </div>
</section>

<%# 使い方 %>
<section class="bg-gray-50">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h2 class="text-center section-title mt-0">使い方は3ステップ</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      <li class="rounded border border-gray-200 bg-white p-5">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-blue-600 font-bold text-white">1</span>
        <p class="mt-3 font-semibold">アカウント登録</p>
        <p class="mt-1 muted">メールアドレスだけですぐに開始。</p>
      </li>
      <li class="rounded border border-gray-200 bg-white p-5">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-blue-600 font-bold text-white">2</span>
        <p class="mt-3 font-semibold">CSVをアップロード</p>
        <p class="mt-1 muted">カード明細のCSVを選ぶだけ。手動でまとめて入力も可能。</p>
      </li>
      <li class="rounded border border-gray-200 bg-white p-5">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-blue-600 font-bold text-white">3</span>
        <p class="mt-3 font-semibold">グラフで確認</p>
        <p class="mt-1 muted">月別・カテゴリ別の収支をダッシュボードで把握。</p>
      </li>
    </ol>
  </div>
</section>

<%# 末尾CTA %>
<section class="max-w-3xl mx-auto px-4 py-16 text-center">
  <h2 class="text-2xl font-bold">まずは今月の収支から。</h2>
  <div class="mt-6">
    <%= link_to "無料で始める", new_registration_path, class: "btn-primary" %>
  </div>
</section>
