<%# 未ログイン訪問者向けの公開ランディングページ。デザインは docs/design/DESIGN_SYSTEM.md。 %>

<%# ヒーロー %>
<section class="lp-hero">
  <div class="lp-wrap">
    <div class="lp-herosplit">
      <div>
        <span class="lp-eyebrow">クレカ明細 → 家計簿</span>
        <h1 class="lp-h1">家計を<br><span class="lp-hl">見える化</span></h1>
        <p class="lp-lead">クレジットカードの明細CSVをアップロードするだけ。月別・カテゴリ別の収支を自動で集計し、使いすぎを一目で。</p>
        <ul class="lp-ease">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>明細CSVを取り込むだけ</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>カテゴリ別に自動で集計</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>月別の収支をグラフで確認</li>
        </ul>
        <div class="lp-cta">
          <%= link_to "無料で始める", new_registration_path, class: "lp-btn lp-btn-ink lp-btn-lg" %>
          <%= link_to "ログイン", new_session_path, class: "lp-btn lp-btn-outline" %>
        </div>
        <p class="lp-trust">メールアドレスだけ、1分ではじめられます。</p>
      </div>

      <%# 主役ビジュアル: ノート風ミニダッシュボード（カテゴリ別ドーナツ。数値は紹介用のサンプル） %>
      <div class="lp-dashcard num">
        <div class="lp-dc-top"><b>2026 / 04</b><span class="lp-dc-lb">ダッシュボード</span></div>
        <div class="lp-dc-total"><b>¥182,400</b><span class="lp-chip">直近3ヶ月平均比 +12.4%</span></div>
        <div class="lp-dc-h">カテゴリ別の内訳</div>
        <div class="lp-donut">
          <svg viewBox="0 0 120 120" width="122" height="122" role="img" aria-label="カテゴリ別支出の円グラフ">
            <circle cx="60" cy="60" r="44" fill="none" stroke="#efeadd" stroke-width="18"/>
            <circle cx="60" cy="60" r="44" fill="none" stroke="#c23b2b" stroke-width="18" stroke-dasharray="96 180" transform="rotate(-90 60 60)"/>
            <circle cx="60" cy="60" r="44" fill="none" stroke="#2f6d8a" stroke-width="18" stroke-dasharray="34 242" stroke-dashoffset="-96" transform="rotate(-90 60 60)"/>
            <circle cx="60" cy="60" r="44" fill="none" stroke="#d8a23a" stroke-width="18" stroke-dasharray="17 259" stroke-dashoffset="-130" transform="rotate(-90 60 60)"/>
            <circle cx="60" cy="60" r="44" fill="none" stroke="#6b7794" stroke-width="18" stroke-dasharray="129 147" stroke-dashoffset="-147" transform="rotate(-90 60 60)"/>
            <text x="60" y="56" text-anchor="middle" font-size="13" font-weight="800" fill="#202b45" font-family="Roboto Mono">¥182,400</text>
            <text x="60" y="72" text-anchor="middle" font-size="9" fill="#4a5680">支出合計</text>
          </svg>
          <ul class="lp-legend">
            <li><i class="lp-sw-1"></i>食費<b>¥52,300</b></li>
            <li><i class="lp-sw-2"></i>日用品<b>¥18,740</b></li>
            <li><i class="lp-sw-3"></i>交通<b>¥9,120</b></li>
            <li><i class="lp-sw-4"></i>その他<b>¥102,240</b></li>
          </ul>
        </div>
        <div class="lp-dc-div"></div>
        <div class="lp-rrow"><span class="lp-rname">自動で分類済み <span class="lp-badge-auto">自動</span></span><span class="lp-unc">未分類 0件</span></div>
      </div>
    </div>
  </div>
</section>

<%# できること %>
<section class="lp-sec">
  <div class="lp-wrap">
    <div class="lp-sect"><span class="lp-eyebrow">CAN DO</span><h2>できること</h2></div>
    <div class="lp-cards">
      <div class="lp-card">
        <div class="lp-featic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 15V3M12 3L8 7M12 3l4 4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg></div>
        <h3>CSVで自動集計</h3>
        <p>楽天カードのCSVをそのまま取り込み、手入力なしで明細化。文字コードや金額のカンマも自動処理。</p>
      </div>
      <div class="lp-card">
        <div class="lp-featic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.6 13.4L13.4 20.6a2 2 0 01-2.8 0L3 13V3h10z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor"/></svg></div>
        <h3>カテゴリを自動分類</h3>
        <p>店舗ルール・特別ルールを登録すれば、次回以降の取り込みを自動でカテゴリ分け。</p>
      </div>
      <div class="lp-card">
        <div class="lp-featic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 4-6"/></svg></div>
        <h3>月次ダッシュボード</h3>
        <p>カテゴリ別円グラフ・支出推移・月平均・直近3ヶ月比較で、使いすぎがひと目で分かる。</p>
      </div>
    </div>
  </div>
</section>

<%# 使い方 %>
<section class="lp-sec lp-band">
  <div class="lp-wrap">
    <div class="lp-sect"><span class="lp-eyebrow">3 STEPS</span><h2>使い方は3ステップ</h2></div>
    <ol class="lp-steps">
      <li class="lp-step"><div class="lp-stepn num">1</div><h3>アカウント登録</h3><p>メールアドレスだけですぐに開始。</p></li>
      <li class="lp-step"><div class="lp-stepn num">2</div><h3>CSVをアップロード</h3><p>カード明細のCSVを選ぶだけ。手動でまとめて入力も可能。</p></li>
      <li class="lp-step"><div class="lp-stepn num">3</div><h3>グラフで確認</h3><p>月別・カテゴリ別の収支をダッシュボードで把握。</p></li>
    </ol>
  </div>
</section>

<%# 末尾CTA %>
<section class="lp-sec lp-final">
  <div class="lp-wrap">
    <h2>まずは今月の収支から。</h2>
    <p>メールアドレスだけ、1分ではじめられます。</p>
    <%= link_to "無料で始める", new_registration_path, class: "lp-btn lp-btn-ink lp-btn-lg" %>
  </div>
</section>
