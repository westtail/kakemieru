<div class="max-w-md">
  <h1 class="page-title">新しいパスワードの設定</h1>

  <%= render "shared/error_messages", record: @user %>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="field">
      <%= form.label :password, "新しいパスワード", class: "field-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "8文字以上", maxlength: 72, class: "field-input" %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "新しいパスワード（確認）", class: "field-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "もう一度入力", maxlength: 72, class: "field-input" %>
    </div>
    <%= form.submit "パスワードを更新", class: "btn-primary" %>
  <% end %>
</div>
