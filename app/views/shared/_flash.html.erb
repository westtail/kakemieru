<%# フラッシュ表示の共通パーシャル。notice=緑 / alert=赤。 %>
<%# turbo-stream で差し替えられるよう id="flash" のコンテナで囲む。 %>
<%# 各メッセージは flash_controller で一定時間後にフェード消滅（閉じるボタンでも消せる）。 %>
<div id="flash">
  <% { notice: "flash-notice", alert: "flash-alert" }.each do |key, variant| %>
    <% if flash[key].present? %>
      <div class="flash <%= variant %>" data-controller="flash"
           role="<%= key == :alert ? "alert" : "status" %>">
        <span class="flex-1"><%= flash[key] %></span>
        <button type="button" class="shrink-0 leading-none opacity-70 hover:opacity-100"
                data-action="flash#dismiss" aria-label="閉じる">&times;</button>
      </div>
    <% end %>
  <% end %>
</div>
