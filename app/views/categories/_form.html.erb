<%# 新規追加・名前変更で共有するフォーム。submit ラベルのみ呼び出し側から渡す。 %>
<%# url/method は form_with が @category の状態（新規=POST / 既存=PATCH）から自動決定する。 %>
<%= render "shared/error_messages", record: @category %>

<%= form_with model: @category do |form| %>
  <div class="field">
    <%= form.label :name, "カテゴリ名", class: "field-label" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "field-input" %>
  </div>
  <%= form.submit submit_label, class: "btn-primary" %>
<% end %>

<p class="mt-4"><%= link_to "カテゴリ一覧に戻る", categories_path, class: "link" %></p>
