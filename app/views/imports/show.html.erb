<h1 class="page-title">取り込み詳細</h1>

<dl class="mt-4 grid grid-cols-[8rem_1fr] gap-y-1 text-sm">
  <dt class="muted">取り込み日時</dt>
  <dd class="num"><%= @import.created_at.strftime("%Y-%m-%d %H:%M") %></dd>
  <dt class="muted">支払方法</dt>
  <dd><%= @import.payment_method.name %></dd>
  <dt class="muted">種別</dt>
  <dd><%= import_source_label(@import.source_type) %></dd>
  <% if @import.source_ref.present? %>
    <dt class="muted">ファイル</dt>
    <dd><%= @import.source_ref %></dd>
  <% end %>
  <dt class="muted">件数</dt>
  <dd><%= @import.row_count %>件（<%= import_status_label(@import.row_count, @active_count) %>）</dd>
</dl>

<%# 更新実行: 取込後に残った未分類へ店舗ルールを当てる（設定OFFでも手動で適用可）。 %>
<div class="mt-4">
  <%= button_to "店舗ルールを未分類に適用", apply_rules_transactions_path, class: "btn-outline",
        form: { data: { turbo_confirm: "未分類の明細に店舗ルールを当てます。よろしいですか？" } } %>
</div>

<h2 class="mt-6 text-lg font-bold">含まれる明細</h2>
<% if @transactions.any? %>
  <div class="overflow-x-auto mt-2">
    <table class="tbl">
      <thead>
        <tr>
          <th>日付</th>
          <th>店舗名</th>
          <th class="text-right">金額</th>
          <th>カテゴリ</th>
          <th>状態</th>
        </tr>
      </thead>
      <tbody>
        <% @transactions.each do |transaction| %>
          <% canceled = transaction.deleted_at.present? %>
          <tr class="<%= "line-through opacity-60" if canceled %>">
            <td class="num whitespace-nowrap"><%= transaction.effective_date.strftime("%-m/%-d") %></td>
            <td><%= transaction.merchant_name %></td>
            <td class="num text-right whitespace-nowrap"><%= number_to_currency(transaction.effective_amount, unit: "¥", precision: 0) %></td>
            <td><%= transaction.category&.name || "未分類" %></td>
            <td>
              <% if canceled %>
                <span class="badge badge-mut no-underline">取消済</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="mt-2 muted">この取り込みに明細はありません。</p>
<% end %>

<div class="mt-6 flex items-center gap-4">
  <%= link_to "取り込み履歴に戻る", imports_path, class: "link" %>
  <% if @active_count.positive? %>
    <%= link_to "この取り込みを取り消す", cancel_confirm_import_path(@import), class: "link-danger" %>
  <% end %>
</div>
