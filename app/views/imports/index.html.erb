<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">取り込み履歴</h1>
  <%= link_to "CSVを取り込む", new_import_path,
        class: "inline-block px-4 py-2 border border-blue-600 rounded text-blue-600 no-underline hover:bg-blue-600 hover:text-white" %>
</div>

<% if @imports.any? %>
  <table class="mt-4 w-full border-collapse text-sm">
    <thead>
      <tr class="border-b border-gray-300 text-left text-gray-600">
        <th class="py-2 pr-4">取り込み日時</th>
        <th class="py-2 pr-4">支払方法</th>
        <th class="py-2 pr-4 text-right">件数</th>
        <th class="py-2 pr-4">状態</th>
        <th class="py-2 pr-4">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @imports.each do |import| %>
        <% active_count = @active_counts[import.id] || 0 %>
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-4 whitespace-nowrap"><%= import.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="py-2 pr-4">
            <%= import.payment_method.name %>
            <% if import.source_ref.present? %>
              <span class="block text-xs text-gray-500"><%= import.source_ref %></span>
            <% end %>
          </td>
          <td class="py-2 pr-4 text-right"><%= import.row_count %>件</td>
          <td class="py-2 pr-4">
            <span class="<%= import_status_class(import.row_count, active_count) %>">
              <%= import_status_label(import.row_count, active_count) %>
            </span>
          </td>
          <td class="py-2 pr-4 whitespace-nowrap">
            <%= link_to "詳細", import_path(import), class: "text-blue-600 hover:underline" %>
            <% if active_count.positive? %>
              <%= link_to "取り消し", cancel_confirm_import_path(import), class: "ml-2 text-red-600 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="mt-4 text-gray-600">取り込み履歴はまだありません。</p>
<% end %>
