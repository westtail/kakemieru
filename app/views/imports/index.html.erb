<div class="flex items-center justify-between flex-wrap gap-2">
  <h1 class="page-title mb-0">取り込み履歴</h1>
  <%= link_to "CSVを取り込む", new_import_path, class: "btn-primary" %>
</div>

<% if @imports.any? %>
  <div class="overflow-x-auto mt-4">
    <table class="tbl">
      <thead>
        <tr>
          <th>取り込み日時</th>
          <th>支払方法</th>
          <th class="text-right">件数</th>
          <th>状態</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @imports.each do |import| %>
          <% active_count = @active_counts[import.id] || 0 %>
          <tr>
            <td class="num whitespace-nowrap"><%= import.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= import.payment_method.name %>
              <% if import.source_ref.present? %>
                <span class="block text-xs muted"><%= import.source_ref %></span>
              <% end %>
            </td>
            <td class="num text-right"><%= import.row_count %>件</td>
            <td>
              <span class="<%= import_status_class(import.row_count, active_count) %>">
                <%= import_status_label(import.row_count, active_count) %>
              </span>
            </td>
            <td class="whitespace-nowrap">
              <%= link_to "詳細", import_path(import), class: "link" %>
              <% if active_count.positive? %>
                <%= link_to "取り消し", cancel_confirm_import_path(import), class: "link-danger ml-2" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="mt-4 muted">取り込み履歴はまだありません。</p>
<% end %>
