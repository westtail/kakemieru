<div class="flex items-center justify-between flex-wrap gap-2">
  <h1 class="text-2xl font-black">明細</h1>
  <div class="flex items-center gap-2 flex-wrap">
    <%# 更新実行: 店舗ルールを未分類明細へ一括適用（手動分類は上書きしない）。 %>
    <%= button_to "店舗ルールを未分類に適用", apply_rules_transactions_path, class: "btn-outline",
          form: { data: { turbo_confirm: "未分類の明細に店舗ルールを当てます。よろしいですか？" } } %>
    <%= link_to "明細を追加", new_transaction_path, class: "btn-primary" %>
  </div>
</div>

<%# 絞り込みバー（通常の GET フォーム） %>
<div class="card mt-4">
  <%= form_with url: transactions_path, method: :get, class: "flex flex-wrap items-end gap-3" do %>
    <div>
      <%= label_tag "month", "月", class: "field-label" %>
      <%= select_tag "month",
            options_for_select(@month_options.map { |m| [ m.strftime("%Y年%-m月"), m.strftime("%Y-%m") ] }, @month.strftime("%Y-%m")),
            id: "month", class: "ctl" %>
    </div>
    <div>
      <%= label_tag "category", "カテゴリ", class: "field-label" %>
      <%= select_tag "category",
            options_for_select(
              [ [ "すべて", "all" ], [ "未分類", "" ] ] + @categories.map { |c| [ c.name, c.id.to_s ] },
              @category.nil? ? "all" : @category
            ),
            id: "category", class: "ctl" %>
    </div>
    <div class="grow">
      <%= label_tag "q", "キーワード", class: "field-label" %>
      <%= text_field_tag "q", @keyword, id: "q", placeholder: "店舗名で検索", class: "ctl w-full" %>
    </div>
    <%= submit_tag "絞り込む", class: "btn-secondary cursor-pointer" %>
  <% end %>
</div>

<% if @transactions.any? %>
  <div data-controller="bulk-categorize">
    <%# カテゴリ一括適用バー。行チェックボックスは form 属性でこのフォームに紐づく。 %>
    <%= form_with url: categorize_all_transactions_path, method: :patch, id: "bulk-categorize-form",
          class: "barbox mt-4 flex flex-wrap items-center gap-2 p-3" do %>
      <%# 現在の絞り込み/ソートを維持して戻る。 %>
      <%= hidden_field_tag :month, @month.strftime("%Y-%m") %>
      <%= hidden_field_tag :category, @category unless @category.nil? %>
      <%= hidden_field_tag :q, @keyword %>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :direction, @direction %>

      <span class="muted"><span data-bulk-categorize-target="count">0</span> 件選択中</span>
      <label class="sr-only" for="bulk_category_id">一括で設定するカテゴリ</label>
      <%= select_tag :category_id,
            options_for_select([ [ "未分類", "" ] ] + @categories.map { |c| [ c.name, c.id.to_s ] }),
            id: "bulk_category_id", class: "ctl" %>
      <button type="submit" class="btn-primary disabled:opacity-40 disabled:cursor-not-allowed"
              data-bulk-categorize-target="apply" disabled>選択した明細に一括適用</button>
    <% end %>

    <div class="overflow-x-auto mt-3">
      <table class="tbl">
        <thead>
          <tr>
            <th class="w-8">
              <%= check_box_tag "select_all", "1", false, "aria-label": "全選択",
                    data: { "bulk-categorize-target": "all", action: "bulk-categorize#toggleAll" } %>
            </th>
            <th><%= sort_header("日付", "date") %></th>
            <th><%= sort_header("店舗名", "merchant") %></th>
            <th class="text-right"><%= sort_header("金額", "amount") %></th>
            <th><%= sort_header("カテゴリ", "category") %></th>
            <th><%= sort_header("支払方法", "payment_method") %></th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="transactions">
          <%= render partial: "transactions/transaction", collection: @transactions, as: :transaction,
                locals: { categories: @categories } %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <p class="mt-4 muted">該当する明細はありません。</p>
<% end %>
