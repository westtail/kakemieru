<h1 class="text-2xl font-bold">明細の編集</h1>

<%# CSV 原本は不変・表示のみ。訂正は override で行う。 %>
<dl class="mt-4 grid grid-cols-[8rem_1fr] gap-y-1 text-sm text-gray-700">
  <dt class="text-gray-500">利用日（原本）</dt>
  <dd><%= @transaction.date.strftime("%Y-%m-%d") %></dd>
  <dt class="text-gray-500">金額（原本）</dt>
  <dd><%= number_to_currency(@transaction.amount, unit: "¥", precision: 0) %></dd>
  <% if @transaction.description.present? %>
    <dt class="text-gray-500">説明（原本）</dt>
    <dd><%= @transaction.description %></dd>
  <% end %>
</dl>

<%= render "shared/error_messages", record: @transaction %>

<%= form_with model: @transaction, class: "mt-4 space-y-3" do |form| %>
  <div>
    <%= form.label :merchant_name, "店舗名", class: "block text-sm text-gray-600" %>
    <%= form.text_field :merchant_name, required: true, maxlength: 255,
          class: "border border-gray-300 rounded px-2 py-1 w-full max-w-md" %>
  </div>

  <div>
    <%= form.label :category_id, "カテゴリ", class: "block text-sm text-gray-600" %>
    <%= form.collection_select :category_id, @categories, :id, :name,
          { include_blank: "未分類" }, { class: "border border-gray-300 rounded px-2 py-1" } %>
  </div>

  <div>
    <%= form.label :amount_override, "金額（訂正）", class: "block text-sm text-gray-600" %>
    <%= form.number_field :amount_override, step: 1, placeholder: @transaction.amount,
          class: "border border-gray-300 rounded px-2 py-1" %>
    <p class="text-xs text-gray-500">空欄なら訂正なし（原本の金額を使用）。</p>
  </div>

  <div>
    <%= form.label :date_override, "利用日（訂正）", class: "block text-sm text-gray-600" %>
    <%= form.date_field :date_override,
          class: "border border-gray-300 rounded px-2 py-1" %>
    <p class="text-xs text-gray-500">空欄なら訂正なし（原本の利用日を使用）。</p>
  </div>

  <%= form.submit "保存する",
        class: "px-4 py-2 border border-blue-600 rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer" %>
<% end %>

<p class="mt-4">
  <%= link_to "一覧に戻る", transactions_path(month: @transaction.effective_date.strftime("%Y-%m")),
        class: "text-blue-600 hover:underline" %>
</p>
