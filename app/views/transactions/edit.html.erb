<h1 class="page-title">明細の編集</h1>

<%# CSV 原本は不変・表示のみ。訂正は override で行う。 %>
<dl class="mt-4 grid grid-cols-[8rem_1fr] gap-y-1 text-sm">
  <dt class="muted">利用日（原本）</dt>
  <dd class="num"><%= @transaction.date.strftime("%Y-%m-%d") %></dd>
  <dt class="muted">金額（原本）</dt>
  <dd class="num"><%= number_to_currency(@transaction.amount, unit: "¥", precision: 0) %></dd>
  <% if @transaction.description.present? %>
    <dt class="muted">説明（原本）</dt>
    <dd><%= @transaction.description %></dd>
  <% end %>
</dl>

<%= render "shared/error_messages", record: @transaction %>

<%= form_with model: @transaction, class: "mt-6 max-w-md" do |form| %>
  <div class="field">
    <%= form.label :merchant_name, "店舗名", class: "field-label" %>
    <%= form.text_field :merchant_name, required: true, maxlength: 255, class: "field-input" %>
  </div>

  <div class="field">
    <%= form.label :category_id, "カテゴリ", class: "field-label" %>
    <%= form.collection_select :category_id, @categories, :id, :name,
          { include_blank: "未分類" }, { class: "field-input" } %>
  </div>

  <div class="field">
    <%= form.label :amount_override, "金額（訂正）", class: "field-label" %>
    <%= form.number_field :amount_override, step: 1, placeholder: @transaction.amount, class: "field-input" %>
    <p class="muted mt-1 text-xs">空欄なら訂正なし（原本の金額を使用）。</p>
  </div>

  <div class="field">
    <%= form.label :date_override, "利用日（訂正）", class: "field-label" %>
    <%= form.date_field :date_override, class: "field-input" %>
    <p class="muted mt-1 text-xs">空欄なら訂正なし（原本の利用日を使用）。</p>
  </div>

  <%= form.submit "保存する", class: "btn-primary" %>
<% end %>

<p class="mt-6">
  <%= link_to "一覧に戻る", transactions_path(month: @transaction.effective_date.strftime("%Y-%m")),
        class: "link" %>
</p>
