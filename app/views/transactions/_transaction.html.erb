<%# 明細1行。Turbo Stream の replace/remove 対象にするため <tr> に dom_id を付与する。 %>
<%# locals: transaction / categories %>
<tr id="<%= dom_id(transaction) %>" class="<%= "is-uncat" if transaction.category.nil? %>">
  <%# 一括適用の選択。form 属性で一覧上部の一括フォームに紐づける（行内の別フォームと入れ子にしない）。 %>
  <td>
    <%= check_box_tag "transaction_ids[]", transaction.id, false,
          form: "bulk-categorize-form", "aria-label": "選択",
          data: { "bulk-categorize-target": "row", action: "bulk-categorize#toggle" } %>
  </td>
  <td class="num whitespace-nowrap"><%= transaction.effective_date.strftime("%-m/%-d") %></td>
  <td>
    <%= transaction.merchant_name %>
    <% if transaction.corrected? %>
      <span class="badge badge-mut ml-1">訂正</span>
    <% end %>
  </td>
  <td class="num text-right whitespace-nowrap"><%= number_to_currency(transaction.effective_amount, unit: "¥", precision: 0) %></td>
  <td>
    <%# カテゴリのインライン変更。select 変更で PATCH categorize を送信し、行を差し替える。 %>
    <%= form_with url: categorize_transaction_path(transaction), method: :patch, data: { controller: "auto-submit" } do %>
      <%= select_tag "transaction[category_id]",
            options_from_collection_for_select(categories, :id, :name, transaction.category_id),
            include_blank: "未分類",
            "aria-label": "カテゴリ",
            class: "ctl",
            data: { action: "change->auto-submit#submit" } %>
    <% end %>
  </td>
  <td><%= transaction.payment_method.name %></td>
  <td class="whitespace-nowrap" data-controller="confirm-delete">
    <div data-confirm-delete-target="actions" class="flex items-center gap-3">
      <%= link_to "編集", edit_transaction_path(transaction), class: "link" %>
      <button type="button" data-action="confirm-delete#show" data-confirm-delete-target="deleteButton"
              class="link-danger cursor-pointer">削除</button>
    </div>
    <div data-confirm-delete-target="banner" class="hidden items-center gap-2">
      <span class="muted">削除しますか？</span>
      <%= button_to "確定", transaction_path(transaction), method: :delete,
            form_class: "inline", class: "link-danger cursor-pointer",
            data: { "confirm-delete-target": "confirmButton" } %>
      <button type="button" data-action="confirm-delete#hide" class="link cursor-pointer">キャンセル</button>
    </div>
  </td>
</tr>
